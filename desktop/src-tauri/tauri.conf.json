{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealtimeClipboard",
  "version": "../../package.json",
  "identifier": "io.github.akshaynikhare.realtimeclipboard",

  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../../_desktop",
    "devUrl": "http://127.0.0.1:8080"
  },

  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "label": "main",
        "title": "RealtimeClipboard",
        "url": "app.html",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],

    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://realtimeclipboard.fastapicloud.dev wss://realtimeclipboard.fastapicloud.dev; require-trusted-types-for 'script'; trusted-types realtimeclipboard",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "An encrypted clipboard shared between your devices",
    "longDescription": "Copy on one machine and paste on another. RealtimeClipboard watches the system clipboard and sends what you copy, end-to-end encrypted, to the other devices sharing a short key. No account, and nothing is written to disk on any machine or on the relay.",
    "copyright": "MIT",
    "licenseFile": "../../LICENSE",

    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": { "installMode": "perMachine" }
    },

    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "signingIdentity": null
    },

    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  }
}
